# Sao chép file này thành .env. Không commit file .env có mật khẩu thật.
JWT_SECRET=replace-with-a-long-random-session-secret
TWO_FACTOR_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
PRESCRIPTION_SIGNING_KEY=replace-with-a-prescription-signing-secret

# Để trống các dòng SMTP dưới đây nếu chỉ cần OTP demo local.
# Với Gmail: bật 2-Step Verification và tạo App Password 16 ký tự.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=OS TeleHealth <no-reply@telehealth.local>
